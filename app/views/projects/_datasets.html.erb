<%# locals: (project:, datasets:, dataset:) %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1.75fr)_minmax(20rem,1fr)]" id="datasets-container">
  <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex items-center justify-between gap-3 border-b border-stone-100 pb-4">
      <div>
        <h2 class="text-lg font-semibold text-stone-950">Datasets</h2>
        <p class="mt-1 text-sm text-stone-600">Files already uploaded to this project.</p>
      </div>
    </div>

    <% if datasets.any? %>
      <div class="mt-6 space-y-4">
        <% datasets.each do |dataset| %>
          <article id="<%= dom_id(dataset) %>" class="rounded-2xl border border-stone-200 bg-stone-50/70 p-4 sm:p-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-stone-900 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-white"><%= dataset.data_type.humanize %></span>
                  <span class="rounded-full bg-stone-200 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-stone-700"><%= dataset.layer_type.humanize %> layer</span>
                  <span class="rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] <%= dataset_status_badge_classes(dataset.status) %>"><%= dataset.status.humanize %></span>
                </div>
                <h3 class="text-base font-semibold text-stone-950"><%= dataset.display_name %></h3>
                <p class="text-sm text-stone-600">
                Uploaded <%= time_ago_in_words(dataset.created_at) %> ago
                <% if dataset.file.attached? %>
                  • <%= number_to_human_size(dataset.file.byte_size) %>
               <% end %>
                </p>
                <% if dataset.info_message.present? %>
                  <p class="text-sm text-stone-600"><%= dataset.info_message %></p>
                <% end %>
              </div>

              <% if dataset.file.attached? %>
                <%= link_to "Open file", dataset.file, class: "inline-flex items-center justify-center rounded-full border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:border-stone-900 hover:text-stone-950" %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="mt-6 rounded-3xl border border-dashed border-stone-300 bg-stone-50 px-6 py-12 text-center">
        <h3 class="text-lg font-semibold text-stone-900">No datasets uploaded yet</h3>
        <p class="mt-2 text-sm text-stone-600">Add a file to start building the project dataset library.</p>
      </div>
    <% end %>
  </div>

  <aside class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
    <h2 class="text-lg font-semibold text-stone-950">Upload dataset</h2>
    <p class="mt-2 text-sm text-stone-600">For now, upload a zipped Shapefile bundle that includes the `.shp`, `.shx`, and `.dbf` files.</p>

    <%= form_with model: [project, dataset], class: "mt-6 space-y-5" do |form| %>
      <div class="grid gap-2">
        <%= render "components/form_label", form: form, field: "data_type" %>
        <%= form.select :data_type, options_for_select(Dataset::SUPPORTED_DATA_TYPES.to_a, dataset.data_type), {}, class: "block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900" %>
        <p class="text-xs text-stone-500">Only zipped Shapefile uploads are supported in this first version.</p>
      </div>

      <div class="grid gap-2">
        <%= render "components/form_label", form: form, field: "layer_type" %>
        <%= form.select :layer_type, options_for_select(Dataset::UPLOAD_LAYER_TYPES.map { |layer_type| [layer_type.humanize, layer_type] }, dataset.layer_type || "buildings"), {}, class: "block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900" %>
        <p class="text-xs text-stone-500">Uploading a new dataset for the same layer type replaces the previous one immediately.</p>
      </div>

      <div class="grid gap-2">
        <%= render "components/form_label", form: form, field: "file" %>
        <%= form.file_field :file, accept: ".zip,application/zip,application/x-zip-compressed", class: "block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 file:mr-4 file:rounded-full file:border-0 file:bg-stone-900 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-700" %>
        <p class="text-xs text-stone-500">Upload one `.zip` file containing the complete Shapefile bundle.</p>
      </div>

      <div class="flex flex-wrap gap-3 border-t border-stone-100 pt-5">
        <%= form.submit "Upload dataset", class: "cursor-pointer inline-flex items-center justify-center rounded-full bg-stone-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-stone-700" %>
      </div>
    <% end %>
  </aside>
</div>
